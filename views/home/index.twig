{% extends "layouts/main.twig" %}

{% block content %}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page">{{ t('home.title') }}</li>
    </ol>
</nav>

<h3>{{ t('home.welcome', {'username': currentUsername()}) }}</h3>

{% if app.isGuest %}
    <div class="alert alert-info" role="status">{{ t('home.guest_notice') }}</div>
{% endif %}

<div id="user-links" class="row">
    <div class="col-sm-12 col-md-4">
        <div class="d-grid ml-1 mb-3 col-md-9 col-sm-10 col-10">
            <a class="btn btn-info mb-1" href="{{ app.yurl('/questions') }}"><i class="fas fa-question" aria-hidden="true"></i> {{ t('home.questions') }}</a>
            <a class="btn btn-primary mb-1" href="{{ app.yurl('/quiz/setup') }}"><i class="fas fa-award" aria-hidden="true"></i> {{ t('home.quiz') }}</a>
            <a class="btn btn-tertiary mb-1" href="{{ app.yurl('/matching-quiz') }}"><i class="fas fa-list" aria-hidden="true"></i> {{ t('home.matching_quiz') }}</a>
            <a class="btn btn-info mb-1" href="{{ app.yurl('/active-clubs') }}"><i class="fas fa-hiking" aria-hidden="true"></i> {{ t('home.active_clubs') }}</a>
            <a class="btn btn-primary mb-1" href="{{ app.yurl('/stats') }}"><i class="fas fa-glasses" aria-hidden="true"></i> {{ t('home.question_stats') }}</a>
            <a class="btn btn-tertiary mb-1" href="{{ app.yurl('/study-guides') }}"><i class="fas fa-file-pdf" aria-hidden="true"></i> {{ t('home.study_guides') }}</a>
            {% if not app.isGuest %}
                <a class="btn btn-info mb-1" href="{{ app.yurl('/progress') }}"><i class="fas fa-chart-line" aria-hidden="true"></i> {{ t('home.progress') }}</a>
            {% endif %}
            <a class="btn btn-info" href="{{ app.yurl('/settings') }}"><i class="fas fa-gear" aria-hidden="true"></i> {{ t('home.settings') }}</a>
        </div>
    </div>
    <div class="col">
        {% for renderedContent in renderedHomeContents %}
            {% if not renderedContent.isGlobal %}
                <h4>{{ t('home.conference_content') }}</h4>
            {% endif %}
            {% if renderedContent.isLanguageFallback %}
                <div class="alert alert-secondary py-2" role="status">
                    <i class="fas fa-language" aria-hidden="true"></i>
                    {{ t('home.translation_fallback') }}
                </div>
            {% endif %}
            <section class="home-markdown-content{{ renderedContent.isGlobal ? ' home-markdown-global' : ' home-markdown-conference' }}">
                {{ renderedContent.html|raw }}
            </section>
            {% if not loop.last %}<hr>{% endif %}
        {% endfor %}
    </div>
</div>

{% endblock %}
